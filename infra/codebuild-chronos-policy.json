{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-1:975049954782:parameter/flolabs-chronos/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "apprunner:DescribeService",
        "apprunner:ListOperations",
        "apprunner:UpdateService"
      ],
      "Resource": "arn:aws:apprunner:us-east-1:975049954782:service/flolabs-chronos/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:us-east-1:975049954782:repository/flolabs-chronos"
    }
  ]
}
