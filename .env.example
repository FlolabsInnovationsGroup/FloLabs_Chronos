# Database
DATABASE_URL=postgresql://user:password@host:5432/chronos
# Optional internal fallback names still accepted by the app:
FL_CHRONOS_DATABASE_URL=postgresql://user:password@host:5432/chronos
FL_CHRONOS_DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/chronos

# Redis / Vercel KV
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
# Vercel-managed raw Redis URL fallback also supported by the app:
FL_KV_REDIS_URL=redis://...

# Auth (NextAuth v5 uses AUTH_SECRET; NEXTAUTH_SECRET is accepted as fallback)
AUTH_SECRET=your-secret-here
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Notion Integration
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...
# Team Members DB used for Team Member page creation, membership sync, and entry relations.
NOTION_TEAM_MEMBERS_DB_ID=
# Onboarding DB used to create the linked onboarding page for newly invited team members.
NOTION_ONBOARDINGS_DB_ID=a1a106fab63548089279dc54d63eab89
NOTION_TEAMS_DB_ID=
NOTION_TASKS_DB_ID=
# Optional: specific template for Team Member pages created during invitation flow.
# If omitted, Chronos asks Notion to use the Team Members data source default template.
NOTION_TEAM_MEMBER_TEMPLATE_ID=
NOTION_TEAM_MEMBER_TEMPLATE_TIMEZONE=UTC

# Cron job secret (used to authenticate cron routes)
CRON_SECRET=your-cron-secret-here

# Optional email delivery (Resend). Forgot-password uses sendEmail().
RESEND_API_KEY=
# Verified sender domain in Resend. INVITE_FROM_EMAIL is a legacy alias still read by the app.
EMAIL_FROM=
INVITE_FROM_EMAIL=

# Optional profile picture uploads (used by /settings)
BLOB_READ_WRITE_TOKEN=
