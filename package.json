{
  "name": "flolabs-chronos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test -c playwright.production.config.ts e2e/all-accounts-production.spec.ts e2e/users-page-production.spec.ts e2e/invitations-production.spec.ts e2e/test-accounts-users-reports.spec.ts e2e/task-search.spec.ts e2e/control-production.spec.ts",
    "test:e2e:session:live": "PLAYWRIGHT_BASE_URL=https://hcmsmnfq5q.us-east-1.awsapprunner.com playwright test -c playwright.production.config.ts e2e/session-lifecycle-production.spec.ts --project=chromium",
    "test:reset-password:live": "tsx scripts/test-reset-password-live.ts",
    "test:task-search": "tsx scripts/test-task-search-integration.ts",
    "seed": "tsx scripts/seed.ts",
    "db:migrate:invitations-notion": "tsx scripts/migrate-invitations-notion-team-member-id.ts",
    "db:migrate:entry-discussions": "tsx scripts/migrate-entry-discussions.ts",
    "db:migrate:discussion-replies": "tsx scripts/migrate-discussion-replies.ts",
    "db:migrate:applicants": "tsx scripts/migrate-applicants.ts",
    "db:migrate:time-entries-applicant-id": "tsx scripts/migrate-time-entries-applicant-id.ts",
    "db:migrate:tags-applicant-id": "tsx scripts/migrate-tags-applicant-id.ts",
    "db:migrate:discussions-applicant-ids": "tsx scripts/migrate-discussions-applicant-ids.ts",
    "db:migrate:flolabs-id": "tsx scripts/migrate-flolabs-id.ts",
    "db:migrate:flolabs-users": "tsx scripts/migrate-to-flolabs-users.ts",
    "db:migrate:flolabs-users:dry-run": "tsx scripts/migrate-to-flolabs-users.ts --dry-run",
    "db:merge:contacts": "tsx scripts/merge-legacy-and-hubspot-csv-contacts.ts",
    "db:merge:contacts:dry-run": "tsx scripts/merge-legacy-and-hubspot-csv-contacts.ts --dry-run",
    "db:migrate:user-profile-picture": "tsx scripts/migrate-user-profile-picture.ts",
    "import:hubspot:prepare": "python scripts/prepare-hubspot-import.py",
    "import:hubspot:applicants": "tsx scripts/import-hubspot-applicants.ts",
    "import:notion-entries": "tsx scripts/import-notion-entries.ts",
    "import:notion-entries:dry-run": "tsx scripts/import-notion-entries.ts --dry-run",
    "import:notion-entries:skip-ignored": "tsx scripts/import-notion-entries.ts --skip-ignored",
    "aws:provision": "powershell -ExecutionPolicy Bypass -File deploy/aws/provision.ps1",
    "aws:deploy": "powershell -ExecutionPolicy Bypass -File deploy/aws/deploy-app.ps1",
    "aws:migrate-db": "powershell -ExecutionPolicy Bypass -File deploy/aws/migrate-db.ps1",
    "db:backfill:imported-entry-owners": "tsx scripts/backfill-imported-entry-owners.ts",
    "db:backfill:imported-entry-owners:live": "tsx scripts/backfill-imported-entry-owners.ts --live"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@aws-sdk/client-s3": "^3.1058.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.1",
    "next-auth": "5.0.0-beta.30",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "5.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
